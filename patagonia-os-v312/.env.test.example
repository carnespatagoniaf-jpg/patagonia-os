# Credenciales para los smoke tests (npm run test:e2e). Copiar a .env.test
# (que está en .gitignore, nunca se sube) y completar con cuentas reales.
#
# No hace falta ninguna cuenta nueva: usá las que ya existen.

# URL del sitio a probar. Por default apunta al servidor de desarrollo local
# (npm run dev tiene que estar corriendo aparte). Para probar el sitio real
# en vez de local, poner acá su URL (ej. https://patagoniasystem.com.ar).
E2E_BASE_URL=http://localhost:5173

# Un usuario normal (dueño/admin/etc.) de una empresa cualquiera — sirve
# "Francisco (prueba)" si ya existe en tu Supabase.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Opcional: un usuario platform admin (ver supabase/seed/create_platform_admin.sql).
# Si se deja vacío, ese smoke test específico se salta.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
