{
  "name": "@patagonia/connector",
  "version": "0.1.0",
  "private": true,
  "description": "Patagonia Scale Connect: servicio de Windows dueño de los puertos y conexiones de las balanzas de la PC.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts --dev",
    "ports": "tsx src/cli/list-ports.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "package:sea": "node scripts/build.mjs && node scripts/package-sea.mjs"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
