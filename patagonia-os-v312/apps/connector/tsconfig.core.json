{
  // Núcleo del conector: sin tipos del navegador y sin variables sin usar. Quedan
  // afuera los protocolos y lo que los importa (service.ts, main.ts): esos los revisa
  // tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  "exclude": ["src/protocols/**", "src/service.ts", "src/service.test.ts", "src/main.ts"]
}
